# ══════════════════════════════════════════════
# E. Excel Standard Concepts — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ══════════════════════════════════════════════

# ── Django ────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────
DB_NAME=eexcel_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ── CORS ──────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Business Contact ──────────────────────────
WHATSAPP_PRIMARY=+2348098708481
WHATSAPP_SECONDARY=+2348021103711
BUSINESS_EMAIL=ebukaexcel26@gmail.com

# ── Email (for enquiry form) ──────────────────
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@eexcelstandardconcepts.com.ng
EMAIL_HOST_PASSWORD=your-zoho-password

# ── Frontend (Vite) ───────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
